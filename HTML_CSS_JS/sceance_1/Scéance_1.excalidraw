      "boundElements": null,
      "updated": 1763083406069,
      "link": null,
      "locked": false,
      "text": "<title> = Votre PRÉNOM (ce que les gens retiennent de vous)\n\n<meta> = Votre CARTE D'IDENTITÉ (description, mots-clés)\n\n<link> = Vos LUNETTES (le CSS qui permet de voir en couleurs)\n\n<script> = Votre ÉDUCATION (le JS qui vous fait réfléchir)\n\n\"Le <head> c'est votre cerveau : on ne le voit pas, mais il contrôle tout !\"",
      "fontSize": 13.85791329397342,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<title> = Votre PRÉNOM (ce que les gens retiennent de vous)\n\n<meta> = Votre CARTE D'IDENTITÉ (description, mots-clés)\n\n<link> = Vos LUNETTES (le CSS qui permet de voir en couleurs)\n\n<script> = Votre ÉDUCATION (le JS qui vous fait réfléchir)\n\n\"Le <head> c'est votre cerveau : on ne le voit pas, mais il contrôle tout !\"",
      "autoResize": false,
      "lineHeight": 1.25
    },
